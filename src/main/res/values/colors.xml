<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
    ╔══════════════════════════════════════════════════════════════════╗
    ║          GUIA DE CORES — EDITE OS VALORES HEX ABAIXO           ║
    ╠══════════════════════════════════════════════════════════════════╣
    ║  btn_add      → botão "Adicionar contato"   (verde)            ║
    ║  btn_edit     → botão "Alterar contato"     (laranja)          ║
    ║  btn_remove   → botão "Remover contato"     (vermelho)         ║
    ║  btn_save     → botão "Salvar"              (azul escuro)      ║
    ║  header_bg    → fundo do cabeçalho IaraLink (azul)             ║
    ║  card_blue    → fundo do card de contato    (azul)             ║
    ║  background   → fundo geral do app          (salmão)           ║
    ╚══════════════════════════════════════════════════════════════════╝

    IMAGEM DO GIRASSOL:
      Para trocar o girassol, substitua o arquivo:
      app/src/main/res/drawable/sunflower.png
      pelo arquivo de imagem desejado (PNG recomendado).
      Mantenha o mesmo nome "sunflower.png" para não precisar
      alterar o código. Caso queira outro nome, altere também
      em activity_main.xml na linha: android:src="@drawable/sunflower"
    -->

    <color name="background">#FFD6B2</color>
    <color name="header_bg">#4A90D9</color>
    <color name="card_blue">#4A90D9</color>
    <color name="card_message_bg">#F0F0F0</color>
    <color name="card_background">#FFFFFF</color>

    <!-- ↓↓ BOTÕES — troque o valor hex para mudar a cor ↓↓ -->
    <color name="btn_add">#2E7D32</color>
    <color name="btn_edit">#E65100</color>
    <color name="btn_remove">#B71C1C</color>
    <color name="btn_save">#1565C0</color>

    <!-- Texto -->
    <color name="text_primary">#1A1A1A</color>
    <color name="text_secondary">#555555</color>
    <color name="text_white">#FFFFFF</color>

    <!-- Aliases internos usados no código Java -->
    <color name="primary">#1565C0</color>
    <color name="primary_dark">#0D47A1</color>
    <color name="accent_green">#2E7D32</color>
    <color name="accent_red">#B71C1C</color>
    <color name="divider">#E0E0E0</color>

</resources>
